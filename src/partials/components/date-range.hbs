{{#if startDate}}
	{{#if format}}
		{{moment startDate format datejs=false}}
	{{else}}
		{{#if short}}
			{{moment startDate "YYYY" datejs=false}}
		{{else}}
			{{moment startDate "MMM YYYY" datejs=false}}
		{{/if}}
	{{/if}}
	-
	{{#if endDate}}
		{{#if format}}
			{{moment endDate format datejs=false}}
		{{else}}
			{{#if short}}
				{{moment endDate "YYYY" datejs=false}}
			{{else}}
				{{moment endDate "MMM YYYY" datejs=false}}
			{{/if}}
		{{/if}}
	{{else}}
		{{t 'Present'}}
	{{/if}}
{{/if}}
