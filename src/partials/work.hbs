{{#if resume.work.length}}
<section id="work">
	{{>components/header level=2 title=(t 'Work')}}
	<div class="flex flex-col gap-5">
		{{#each resume.work}}
		{{#if summary}}
			<article class="flex flex-col">
				<div class="flex items-baseline">
					<div class="shrink-0 font-bold text-sm w-36 print:text-xs print:w-32">
						{{>components/date-range startDate=startDate endDate=endDate}}
					</div>
					<h3 class="m-0 font-bold leading-snug">
						{{#if name}}
							{{name}},
						{{/if}}

						{{#if position}}
							{{position}}
						{{/if}}
					</h3>
				</div>
				
				<div>
					{{#if description}}
					<!--<p class="font-light text-sm print:text-xs italic">{{description}}</p>-->
					{{/if}}
					
					<p>{{summary}}</p>

					{{#if highlights.length}}
					<ul class="list-disc mt-0.5">
						{{#each highlights}}
						<li class="ml-8">{{.}}</li>
						{{/each}}
					</ul>
				{{/if}}
				</div>
			</article>
		{{else}}
			<article class="flex items-baseline {{#unless @last}}-mb-5 {{/unless}} text-sm print:text-xs">
				<div class="shrink-0 font-bold w-36 print:w-32">
					{{>components/date-range startDate=startDate endDate=endDate short=true}}
				</div>
				<h3 class="m-0 font-bold leading-snug">
					{{#if name}}
						{{name}},
					{{/if}}

					{{#if position}}
						{{position}}
					{{/if}}
				</h3>
			</article>
		{{/if}}
		{{/each}}
	</div>
</section>
{{/if}}