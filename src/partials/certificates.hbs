{{#if resume.certificates.length}}
<section id="certificates">
	{{>components/header level=2 title=(t 'Certificates')}}
	<div class="flex flex-col gap-2">
		{{#each resume.certificates}}
		<article class="flex">
			<div class="text-sm font-bold w-24 print:w-20">
				{{#if date}}
					{{moment date "YYYY" datejs=false}}
				{{/if}}
			</div>
			<div>
				{{#if name}}
				<span class="font-bold">{{name}}</span>
				{{/if}}
				{{#if issuer}}
				<span>{{#if name}}, {{/if}}{{issuer}}</span>
				{{/if}}
			</div>
		</article>
		{{/each}}
	</div>
</section>
{{/if}}
