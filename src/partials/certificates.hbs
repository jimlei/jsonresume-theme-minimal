{{#if resume.certificates.length}}
<section id="certificates">
	{{>components/header level=2 title=(t 'Certificates')}}
	<div class="flex flex-col gap-2">
		{{#each resume.certificates}}
		<article class="flex">
			<div class="text-sm font-bold w-36 print:w-32 shrink-0">
				{{#if date}}
					{{moment date "YYYY" datejs=false}}
				{{/if}}
			</div>
			<div class="font-bold">
				{{name}}{{#if issuer}}{{#if name}}, {{/if}}{{issuer}}{{/if}}
			</div>
		</article>
		{{/each}}
	</div>
</section>
{{/if}}
