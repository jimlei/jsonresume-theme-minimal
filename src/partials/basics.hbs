{{#resume.basics}}
	<section id="basics">
		{{>components/header level=1 title=(default name (t 'CV'))}}
		{{#if summary}}
		<p class="mb-2">{{summary}}</p>
		{{/if}}
		<div>
			<div class="flex gap-2">
				{{#if phone}}
				<div class="flex gap-1 items-center">
					<i class="bi bi-phone-fill"></i>
					{{phone}}
				</div>
				{{/if}}

				{{#if email}}
					<a href="mailto:{{email}}" class="flex gap-1 items-center">
						<i class="bi bi-envelope-fill"></i>
						{{email}}
					</a>
				{{/if}}

				{{#location}}
					{{#if address}}
					<div class="flex gap-1 items-center">
						<i class="bi bi-mailbox2"></i>
						{{address}}{{#if postalCode}}, {{postalCode}}{{/if}}

						{{#if city}}
						{{city}}
						{{/if}}
					</div>
					{{/if}}
				{{/location}}

				{{#if url}}
					<a href="{{url}}" class="flex gap-1 items-center">
					<i class="bi bi-house-fill"></i>
						{{url}}
					</a>
				{{/if}}

				{{#if birthDate}}
					<div class="flex gap-1 items-center">
					<i class="bi bi-calendar"></i>
						{{birthDate}}
					</div>
				{{/if}}
			</div>
		</div>
	</section>
{{/resume.basics}}