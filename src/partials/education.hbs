{{#if resume.education.length}}
<section id="education">
	{{>components/header level=2 title=(t 'Education')}}
	<div class="flex flex-col gap-3">
		{{#each resume.education}}
		<article class="flex">
			<div class="text-sm font-bold w-36 print:w-32">
				{{>components/date-range startDate=startDate endDate=endDate short=true}}
			</div>
			<div>
				<span class="font-bold">
					{{#if institution}}
						{{institution}},
					{{/if}}

					{{#if area}}
						{{area}}
					{{/if}}

					{{#if studyType}}
						{{studyType}}
					{{/if}}
				</span>

				{{#if gpa}}
				<div >
					GPA: {{gpa}}
				</div>
				{{/if}}

				{{#if courses.length}}
				<ul class="list-disc mt-0.5">
					{{#each courses}}
					<li class="ml-8">{{.}}</li>
					{{/each}}
				</ul>
			{{/if}}
			</div>
		</article>
		{{/each}}
	</div>
</section>
{{/if}}