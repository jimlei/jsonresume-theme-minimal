<section id="references">
	{{>components/header level=2 title=(t 'References')}}
	{{#each resume.references}}
	<div >
		{{#if reference}}
		<blockquote>
			{{reference}}
		</blockquote>
		{{/if}}
		{{#if name}}
		<div >
			— {{name}}
		</div>
		{{/if}}
	</div>
	{{else}}
		<p>{{t 'References provided upon request.'}}</p>
	{{/each}}
</section>